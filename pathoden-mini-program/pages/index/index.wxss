.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background-color: #f9f9f9;
  min-height: 100vh;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
}

.upload-button, .detect-button {
  width: 80%;
  margin: 20rpx 0;
  padding: 20rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
  background-color: #4A90E2;
  color: white;
  border: none;
}

.upload-button:active, .detect-button:active {
  background-color: #357ABD;
}

.preview-image {
  width: 80%;
  margin-top: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.result-container {
  margin-top: 60rpx;
  width: 90%;
  background: #ffffff;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}
