<view class="container">
  <view class="title">Pathogen Concentration Detection</view>

  <button class="upload-button" bindtap="chooseImage">Upload Photo</button>

  <image wx:if="{{imagePath}}" class="preview-image" src="{{imagePath}}" mode="aspectFit"></image>

  <button 
    class="detect-button" 
    bindtap="startDetection" 
    loading="{{loading}}" 
    disabled="{{loading}}">
    {{ loading ? 'Detecting...' : 'Start Detection' }}
  </button>

  <view id="result" wx:if="{{resultText}}" class="result-container">
    <text>{{resultText}}</text>
  </view>
</view>
